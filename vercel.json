{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "installCommand": "npm ci",
  "buildCommand": "npm run build:vercel",
  "outputDirectory": ".next",
  "redirects": [
    {
      "source": "/:path*",
      "has": [{"type": "host", "value": "clearance-4gma.vercel.app"}],
      "destination": "https://clearance-two.vercel.app/:path*",
      "permanent": false
    }
  ]
}
